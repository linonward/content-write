{
  "name": "@content-write/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@content-write/db": "workspace:*",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
