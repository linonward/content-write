{
  "name": "@content-write/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run tests/integration --no-file-parallelism",
    "auth:check": "node --env-file-if-exists=../../.env.local node_modules/auth/dist/index.mjs check schema --config src/modules/identity/auth.ts",
    "auth:create-admin": "node --env-file-if-exists=../../.env.local node_modules/auth/dist/index.mjs create-admin --config src/modules/identity/auth.ts",
    "smoke:deepseek": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run tests/smoke/deepseek.smoke.test.ts",
    "eval:breakdown": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run tests/smoke/breakdown-eval.smoke.test.ts",
    "smoke:framework": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run tests/smoke/framework.smoke.test.ts",
    "smoke:profile": "node --env-file-if-exists=../../.env.local ../../node_modules/vitest/vitest.mjs run tests/smoke/profile.smoke.test.ts",
    "smoke:link-fetch": "node ../../node_modules/vitest/vitest.mjs run tests/smoke/link-fetch.smoke.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@content-write/db": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@mozilla/readability": "0.6.0",
    "better-auth": "1.7.7",
    "cheerio": "1.2.0",
    "hono": "4.13.12",
    "linkedom": "0.18.13",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "@types/node": "24.10.4",
    "auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
