{
  "name": "content-write-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@content-write/web --filter=@content-write/api",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @content-write/db test:integration && pnpm --filter @content-write/api test:integration",
    "db:migrate": "pnpm --filter @content-write/db db:migrate",
    "db:generate": "pnpm --filter @content-write/db db:generate",
    "worker:dev": "pnpm --filter @content-write/worker dev",
    "worker:start": "pnpm --filter @content-write/worker start",
    "api:dev": "pnpm --filter @content-write/api dev",
    "web:dev": "pnpm --filter @content-write/web dev",
    "test:e2e": "pnpm --filter @content-write/e2e e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "auth:check": "pnpm --filter @content-write/api auth:check",
    "auth:create-admin": "pnpm --filter @content-write/api auth:create-admin"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "turbo": "2.11.6"
  },
  "type": "module"
}
